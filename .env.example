# ============================================================
# Earthyy environment configuration
# Copy to backend/.env (or export in the environment) and edit.
# All backend variables use the EARTHYY_ prefix.
# ============================================================

# --- Security (REQUIRED in production) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
EARTHYY_SECRET_KEY=change-me-in-production
EARTHYY_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated allowed browser origins
EARTHYY_CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL + PostGIS) ---
EARTHYY_DATABASE_URL=postgresql+psycopg2://earthyy:earthyy@localhost:5432/earthyy

# --- Redis / background jobs ---
EARTHYY_REDIS_URL=redis://localhost:6379/0
# Set true only for tests/single-process dev (runs jobs inline in the API process)
EARTHYY_EAGER_JOBS=false

# --- Object storage ---
# local = filesystem under EARTHYY_STORAGE_ROOT (default <repo>/data/storage)
EARTHYY_STORAGE_BACKEND=local
# EARTHYY_STORAGE_ROOT=/absolute/path/to/storage

# --- Satellite providers ---
# earth_search (default, no credentials) | planetary_computer (no credentials) | copernicus
EARTHYY_DEFAULT_PROVIDER=earth_search
# Copernicus Data Space credentials — ONLY needed for Copernicus asset downloads.
# Catalogue search works without them. Register at https://dataspace.copernicus.eu
EARTHYY_COPERNICUS_CLIENT_ID=
EARTHYY_COPERNICUS_CLIENT_SECRET=

# --- Processing limits ---
EARTHYY_MAX_AOI_KM2=5000
EARTHYY_DEFAULT_MAX_CLOUD_COVER=30
